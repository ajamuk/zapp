# --- Modo ---
# shadow: la IA no envía nada; deja su respuesta como nota interna en GHL para compararla con la real.
# live: la IA envía. No pasar a live sin la aprobación de Carlos.
MODE=shadow
PORT=3200
DB_PATH=./data/setter.db
TZ=Europe/Madrid

# --- Seguridad ---
# Secreto que GHL manda en la cabecera x-setter-secret de sus webhooks (configurarlo en el workflow de GHL).
WEBHOOK_SECRET=
# Token para las rutas /admin
ADMIN_TOKEN=

# --- IA ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Retardo humano antes de responder (segundos) y velocidad de escritura (letras/segundo)
AI_MIN_DELAY=15
AI_MAX_DELAY=50
AI_TYPING_SPEED=4
# Horario en el que contesta (horas, Europe/Madrid). FIN=0 significa medianoche.
AI_HORA_INICIO=8
AI_HORA_FIN=0

# --- GoHighLevel ---
GHL_TOKEN=
GHL_LOCATION_ID=ZzJQpaOb7hMdco1EsiiF
# Usuarios de GHL responsables de cada sede (IDs de usuario)
GHL_USER_PARLA=
GHL_USER_GETAFE=
GHL_USER_LAS_ROSAS=
# Calendario de GHL para la prueba de Parla
GHL_CALENDAR_PRUEBA_PARLA=

# --- AimHarder ---
# Búsqueda de socios por teléfono (API). Ver docs/aimharder.md
AIMHARDER_API_URL=
AIMHARDER_API_KEY=
# Alta por navegador (panel de administración)
AIMHARDER_ADMIN_URL=
AIMHARDER_ADMIN_USER=
AIMHARDER_ADMIN_PASSWORD=
# true = el alta se rellena pero NO se guarda (para probar)
AIMHARDER_ALTA_DRY_RUN=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_PARLA=
TELEGRAM_CHAT_GETAFE=
TELEGRAM_CHAT_LAS_ROSAS=
TELEGRAM_CHAT_GENERAL=
