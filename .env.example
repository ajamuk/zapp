# --- Modo ---
# shadow: la IA no envía nada; deja su respuesta como nota interna en GHL para compararla con la real.
# live: la IA envía. No pasar a live sin la aprobación de Carlos. Exige el aislamiento en un número propio
# (SOFIA_WA_NUMERO y SOFIA_WA_LOCATION_ID, más abajo): sin él, en live el servicio no recibe ni envía nada.
MODE=shadow
# false: panel y simulador disponibles, sin admitir eventos ni ejecutar la cola de GHL.
GHL_WEBHOOK_ENABLED=true
PORT=3200
# Dirección en la que escucha: 127.0.0.1 detrás de nginx en el mismo servidor; 0.0.0.0 dentro de un contenedor
HOST=127.0.0.1
DB_PATH=./data/setter.db
# Carpeta de configuración del negocio (instrucciones, negocio.json, tarifas, horarios…). Vacío = ./config del repositorio
CONFIG_DIR=
# Dirección pública del servicio: GHL descarga de aquí los recursos y notas de voz que envía Sofía (PUBLIC_URL/r/…)
PUBLIC_URL=
# Zona horaria del negocio (horario de respuesta, seguimientos, festivos), independiente de la del servidor
BUSINESS_TZ=Europe/Madrid
TZ=Europe/Madrid

# --- Seguridad ---
# Las dos claves, aleatorias y de al menos 24 caracteres (openssl rand -hex 24). Si faltan o son cortas, sale una alerta en el panel.
# Secreto que GHL manda en la cabecera x-setter-secret de sus webhooks (configurarlo en el workflow de GHL).
WEBHOOK_SECRET=
# Token para las rutas /admin
ADMIN_TOKEN=

# --- IA ---
ANTHROPIC_API_KEY=
# Opcional: para ver en Consumo lo que factura Anthropic al lado de lo que apunta zapp (clave de administrador, solo lectura de costes)
ANTHROPIC_ADMIN_KEY=
# ANTHROPIC_API_KEY_ID=apikey_...   (si no se pone, se busca solo)
AI_MODEL=claude-sonnet-5-5
# Esfuerzo de razonamiento de Sofía (low | medium | high | xhigh | max; vacío = el del modelo)
AI_EFFORT=medium
# Caché del prompt y la base de conocimiento: 1h o 5m
AI_CACHE_TTL=1h
# Modelo que redacta los textos de los seguimientos
SEGUIMIENTOS_MODEL=claude-haiku-5-5
# Retardo humano antes de responder (segundos) y velocidad de escritura (letras/segundo)
AI_MIN_DELAY=15
AI_MAX_DELAY=50
AI_TYPING_SPEED=4
# Tope de «escribiendo…» por burbuja, en segundos
AI_TYPING_MAX=12
# Horario en el que contesta (horas, Europe/Madrid). FIN=0 significa medianoche.
AI_HORA_INICIO=8
AI_HORA_FIN=0

# --- GoHighLevel ---
GHL_TOKEN=
GHL_LOCATION_ID=
# Usuario de GHL responsable de cada sede: GHL_USER_<ID DE LA SEDE EN MAYÚSCULAS> (sedes en config/negocio.json).
# Una sede sin usuario propio usa el de su «equipo».
GHL_USER_PARLA=
GHL_USER_GETAFE=
GHL_USER_LAS_ROSAS=
# Opcional: otros hosts (separados por comas) a los que se puede enviar el token de GHL para descargar adjuntos
# que piden autenticación. Por defecto solo los de GHL (leadconnectorhq.com, msgsndr.com, gohighlevel.com).
# GHL_MEDIA_HOSTS=
# Aislamiento en un número de WhatsApp propio (docs/aislamiento-whatsapp.md). Los dos vacíos = sin aislamiento
# (solo válido con MODE=shadow). La subcuenta tiene que ser solo de Sofía: no se admite compartirla con otra línea.
# Con los dos puestos, Sofía solo atiende WhatsApp dirigido a ese número de esa subcuenta y envía siempre desde él.
# A medias o incoherentes (p. ej. la subcuenta no coincide con GHL_LOCATION_ID): no entra ni sale nada.
# SOFIA_WA_NUMERO=+34...
# SOFIA_WA_LOCATION_ID=
# Si ese número es el que la subcuenta ya tenía: los chats que había se adoptan cuando GHL confirma que son suyos
# SOFIA_WA_ADOPTAR_CHATS=true
# Declara que el workflow «Sofía · enviar plantilla» envía desde ese número (sin esto, no salen plantillas)
# SOFIA_WA_PLANTILLAS=true
# Calendario de GHL para la prueba de Parla
GHL_CALENDAR_PRUEBA_PARLA=

# --- AimHarder ---
# Opción A (VPS): tokens compartidos con las demás apps, en el almacén que renueva el cron central.
# Si está puesto, se ignoran los AIMHARDER_TOKEN_* de abajo y Sofía nunca renueva tokens.
AIMHARDER_TOKEN_STORE=
# Opción B: API pública con un par de tokens propios por sede (las de config/negocio.json con "aimharder": true).
# Los renovados se guardan en data/aimharder-tokens.json
AIMHARDER_TOKEN_PARLA=
AIMHARDER_REFRESH_PARLA=
AIMHARDER_TOKEN_GETAFE=
AIMHARDER_REFRESH_GETAFE=
AIMHARDER_TOKEN_LAS_ROSAS=
AIMHARDER_REFRESH_LAS_ROSAS=
# Alta por navegador (panel de administración)
# Webhooks de AimHarder (docs/aimharder-webhooks.md): token común (va en la URL) y la clave privada RSA de cada sede,
# en PEM con los saltos de línea escritos como \n, o la ruta a un fichero (…_FILE)
AIMHARDER_WEBHOOK_TOKEN=
AIMHARDER_WEBHOOK_KEY_PARLA=
AIMHARDER_WEBHOOK_KEY_GETAFE=
AIMHARDER_WEBHOOK_KEY_LAS_ROSAS=
AIMHARDER_ADMIN_URL=
AIMHARDER_ADMIN_USER=
AIMHARDER_ADMIN_PASSWORD=
# true = el alta se rellena pero NO se guarda (para probar)
AIMHARDER_ALTA_DRY_RUN=true
# Clase de prueba de Parla reservada directamente en AimHarder como invitado (además hace falta MODE=live).
# Con false, Sofía comprueba que la clase existe y avisa al equipo para que la reserve.
AIMHARDER_RESERVA_PRUEBA=false
# Base de metro-trial-ops (pruebas de los calendarios de GHL con asistencia y alta verificadas), solo lectura
TRIAL_OPS_DB=/var/lib/metro-trial-ops/trial_ops.sqlite3

# --- Embudo del panel ---
# Carpeta con los informes mensuales de pruebas de AimHarder (los genera metro-trial-crm)
EMBUDO_PRUEBAS_DIR=/opt/metro-trial-crm/data

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Chat de cada sede (TELEGRAM_CHAT_<ID>); lo que no tiene chat propio va al general
TELEGRAM_CHAT_PARLA=
TELEGRAM_CHAT_GETAFE=
TELEGRAM_CHAT_LAS_ROSAS=
TELEGRAM_CHAT_GENERAL=

# Teléfonos del equipo para probar a Sofía por WhatsApp como un lead más: se tratan como lead aunque sean socios
# y, también en modo shadow, reciben las respuestas de verdad. Separados por comas: +34600111222,+34600333444
TEST_PHONES=
# Mensaje que, enviado desde uno de esos teléfonos, borra su conversación para empezar de cero (no vale para leads)
TEST_RESET_WORD=#reset

# --- Alertas ---
# Horas sin mensajes de leads (de 11 a 21 h) para avisar de que no llega nada de GHL. 0 = no avisar
ALERTA_SIN_MENSAJES_HORAS=6
# Una alerta que se cierra y se vuelve a abrir no repite el aviso por Telegram en estas horas. 0 = avisar siempre
ALERTAS_REAVISO_HORAS=3

# --- Limpieza de datos efímeros (cada hora, en el mantenimiento). Días que se guardan; 0 = no borrar ---
# Nunca se borran mensajes ni archivos de los leads.
# Capturas de pantalla de altas de AimHarder que fallaron (pueden llevar datos personales)
PODA_CAPTURAS_DIAS=14
# Notas de voz que generó Sofía (el texto queda en el chat)
PODA_VOZ_DIAS=60
# Alertas ya resueltas
PODA_ALERTAS_DIAS=90
# Resultados de la batería de pruebas
PODA_BATERIA_DIAS=180

# Formularios web de Nexor. Sin SOFIA_FORMULARIOS_DESDE queda apagado.
# Poner una fecha de corte ISO con zona solo tras aprobar la plantilla y retirar el envío previo.
SOFIA_FORMULARIOS_DESDE=
SOFIA_FORMULARIOS_IDS=
SOFIA_FORMULARIOS_CAMPO_SERVICIO=
SOFIA_FORMULARIOS_CAMPO_ASUNTO=
SOFIA_FORMULARIOS_PLANTILLA=
# Clave compartida exclusivamente con la tableta VPS; dejar vacía si no se usa.
SOFIA_RECEPCION_SECRET=
SOFIA_PRUEBAS_SECRET=
